---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/gold-price-per-gram/" title="Gold price per gram by carat, UK" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the UK gold price per gram calculator on your site" description="Show the gold price per gram by carat on your own site for free: one iframe, 9ct to 24ct at the live spot price in pounds with its time, no sign-up and no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the gold price calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a personal finance blog, a money advice page or a jeweller’s guide: visitors choose a carat and a weight and see the metal value at the spot price of the moment, with the time of that price.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the calculator visible and use it as it is, without warranty. The spot price comes from gold-api.com, which gives no guarantee of accuracy.</p>
    <p>Nothing your visitors type reaches us and the frame sets no cookie. The only request the frame makes is for the gold price, to gold-api.com. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/gold-price-per-gram/" title="Gold price per gram by carat, UK" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
