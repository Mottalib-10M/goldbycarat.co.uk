---
/**
 * Accueil (pilier) : titre, une ligne, prix du gramme par carat (simulateur, premier écran), bloc
 * citable replié, puis le corps (titres légaux, offre d'acheteur, pièces, argent, impôts), FAQ.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Tool from './calc/Tool';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { helpers, fill } from '../lib/helpers';
import { replierSections } from '../lib/replis';
import { route } from '../i18n/routes';
import { label, navCategories } from '../i18n/nav';
import { t } from '../i18n/ui';
import { P } from '../lib/engine/params';
import { organizationSchema, websiteSchema, webApplicationSchema, faqSchema, webPageSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
const lang = 'en' as const;
const H = HOME;
const x = { title: fill(H.title), description: fill(H.description), h1: fill(H.h1), lead: fill(H.lead), resume: fill(H.resume), faqs: H.faqs.map((f) => ({ q: fill(f.q), a: fill(f.a), open: f.open })) };
const body = replierSections(fill(H.body(helpers())), 0, 'More about gold, carats, coins and tax: tap a heading to open it.');
const parts = body.split(/<!--tool:([a-z]+)-->/);
const path = route('home', lang);
const ui = t(lang);
const jsonLd = [organizationSchema(lang), websiteSchema(lang), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const sources = ['goldApi', 'hallmarkSch1', 'hallmarkSch2', 'ukWeights', 'coinageAct', 'rmSovereign', 'tcga21', 'tcga262', 'govCgtRates', 'vatNotice70121'].map((k) => ({ name: P.sources[k].label.en, url: P.sources[k].url }));
const cats = navCategories(lang, false);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <h1 class="mb-1 text-[1.6rem] font-bold leading-tight text-navy-900 sm:text-3xl">{x.h1}</h1>
  <p class="mb-3 text-navy-700">{x.lead}</p>
  {/* 2026-11-10 (testeur de 61 ans) : « Inherited some gold? » était le 3e de quatre liens sous le résultat. Portes
       d'entrée par situation, en boutons, avant le calculateur. */}
  <nav aria-label="Start from your situation" class="mb-3 grid grid-cols-2 gap-2 text-sm font-medium" data-chrome>
    {[[route('inherited', lang), 'I inherited some jewellery'], [route('offer', lang), 'I have an offer to check'], [route('scrap', lang), 'Several pieces, mixed carats'], [route('sovereign', lang), 'Gold coins (sovereigns)']].map(([h, l]) => <a href={h} class="flex min-h-[44px] items-center rounded-lg border border-accent-300 bg-accent-50 px-3 py-1.5 leading-snug text-navy-900 hover:border-accent-500">{l} →</a>)}
  </nav>
  <div class="mb-8"><Tool client:load tool="board" idp="b" ct={9} grams={10} /></div>
  <Clamp text={x.resume} lang={lang} id="clamp-home" label={ui.readMore} class="mb-8" />
  <div class="prose prose-slate max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <div id={p} class="not-prose my-6 scroll-mt-20" data-chrome><Tool client:load tool={p} idp={`h${i}`} mini /></div>)}
  </div>
  {/* Test naïf, 4e tour : la liste complète des liens venait deux fois (ici, puis dans le pied de page). Repliée. */}
  <details class="pli" style="margin-top:0;border-top:0" data-chrome>
    <summary><h2 class="text-2xl font-bold text-navy-900">All calculators and guides</h2></summary>
    <div class="mt-3 grid gap-6 sm:grid-cols-3">
      {cats.map((c) => (<div><h3 class="mb-2 font-semibold text-navy-900">{c.label}</h3><ul class="space-y-1 text-sm">{c.links.map((l) => <li><a href={l.href} class="text-accent-700 hover:underline">{l.label}</a></li>)}</ul></div>))}
    </div>
  </details>
</PageLayout>
