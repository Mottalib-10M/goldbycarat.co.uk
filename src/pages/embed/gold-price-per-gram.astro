---
/** Calculateur à intégrer (iframe) : sans navigation, noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/calc/Tool';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gold price per gram by carat, UK (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Tool client:load tool="board" idp="w" ct={9} grams={10} />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · Independent site by Radif Partners, not a gold buyer or a dealer · spot price from gold-api.com, worked out in your browser</p>
    <p class="mt-1 text-center text-xs text-navy-600">Contains public sector information licensed under the Open Government Licence v3.0. <a href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/" target="_blank" rel="nofollow noopener" class="underline">Open Government Licence v3.0</a></p>
  </body>
</html>
